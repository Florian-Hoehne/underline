  "permissions": [
    "core:event:default",
    "core:window:allow-show",
    "allow-app-start",
    "allow-settings-quick",
    "allow-settings-window",
    "allow-settings-set",
    "allow-wiki-check",
    "allow-ws-start",
    "allow-ws-recent",
    "allow-ws-open",
    "allow-ws-check-new",
    "allow-ws-create",
    "allow-tab-open",
    "allow-tab-activate",
    "allow-tab-close",
    "allow-tab-store",
    "allow-tab-set-view",
    "allow-ed-viewport",
    "allow-ed-sync",
    "allow-ed-resync",
    "allow-ed-mirror",
    "allow-app-request-close",
    "allow-clip-read-text",
    "allow-clip-write-text",
    "allow-clip-read",
    "allow-clip-write",
    "allow-clip-store-image",
    "allow-clip-forget",
    "allow-ed-embed",
    "allow-ed-drop",
    "allow-ed-drag",
    "allow-ed-note-link",
    "allow-ed-follow-link",
