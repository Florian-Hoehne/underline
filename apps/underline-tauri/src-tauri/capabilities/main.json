{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window may do: events, show itself after the first render, and the app's own commands.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-show",
    "allow-app-start",
    "allow-settings-quick",
    "allow-wiki-check",
    "allow-ws-start",
    "allow-ws-recent",
    "allow-ws-open",
    "allow-ws-check-new",
    "allow-ws-create",
    "allow-tab-open",
    "allow-tab-activate",
    "allow-tab-close",
    "allow-tab-store",
    "allow-tab-set-view",
    "allow-fa-open",
    "allow-fa-input",
    "allow-fa-clipboard",
    "allow-fa-keys-status",
    "allow-ed-open",
    "allow-ed-input",
    "allow-ed-select",
    "allow-ed-viewport",
    "allow-ed-clipboard",
    "allow-ed-apply",
    "allow-ed-fold",
    "allow-ed-keys-status",
    "allow-ed-sync",
    "allow-ed-resync",
    "allow-ed-mirror",
    "allow-app-request-close",
    "allow-clip-read-text",
    "allow-clip-write-text",
    "allow-app-close-anyway"
  ]
}
